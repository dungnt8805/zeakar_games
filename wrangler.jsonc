{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lamian-site",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"routes": [{ "pattern": "lamian.dev", "custom_domain": true }],
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// .html URLs (app policy links on Google Play) must answer 200 at their exact address, not redirect.
		"run_worker_first": ["/api/*", "/*.html"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lamian-players",
			"database_id": "aa6a6eb1-16b3-4e45-91e2-6e0c80896a02",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{ "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
	],
	"vars": {
		"MAIL_FROM_EMAIL": "no-reply@lamian.dev",
		"MAIL_FROM_NAME": "Lamian"
	}
	// Secrets: MAILJET_API_KEY and MAILJET_SECRET_KEY (`wrangler secret put ...`). Without them, codes are logged instead of emailed.
}
