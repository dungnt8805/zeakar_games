---
import PolicyPage from '../../../components/PolicyPage.astro';
import PRIVACY from '../../../data/privacy-translations.json';
import { LOCALES } from '../../../i18n/ui';
export function getStaticPaths() { return LOCALES.flatMap(locale => Object.keys(PRIVACY).map(game => ({ params: { locale, game }, props: { lang: locale, gameId: game } }))); }
const { lang, gameId } = Astro.props;
---
<PolicyPage lang={lang} gameId={gameId} />
