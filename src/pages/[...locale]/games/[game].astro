---
import GamePage from '../../../components/GamePage.astro';
import { getGames, type Game } from '../../../data/games';
import { LOCALES, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.flatMap(lang => getGames(lang).map(game => ({
    params: { locale: lang === 'en' ? undefined : lang, game: game.id },
    props: { lang, game },
  })));
}

interface Props { lang: Locale; game: Game; }
const { lang, game } = Astro.props;
---

<GamePage lang={lang} game={game} />
