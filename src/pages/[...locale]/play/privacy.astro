---
import WebPrivacyPage from '../../../components/WebPrivacyPage.astro';
import { LOCALES, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { locale: lang === 'en' ? undefined : lang }, props: { lang } }));
}

interface Props { lang: Locale; }
const { lang } = Astro.props;
---

<WebPrivacyPage lang={lang} />
