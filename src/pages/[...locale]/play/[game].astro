---
import ArcadeGamePage from '../../../components/ArcadeGamePage.astro';
import { ARCADE_GAMES, type ArcadeGame } from '../../../data/arcade';
import { LOCALES, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.flatMap(lang => ARCADE_GAMES.map(game => ({
    params: { locale: lang === 'en' ? undefined : lang, game: game.id },
    props: { lang, game },
  })));
}

interface Props { lang: Locale; game: ArcadeGame; }
const { lang, game } = Astro.props;
---

<ArcadeGamePage lang={lang} game={game} />
