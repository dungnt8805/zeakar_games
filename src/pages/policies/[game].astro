---
import PolicyPage from '../../components/PolicyPage.astro';
import PRIVACY from '../../data/privacy-translations.json';
export function getStaticPaths() { return Object.keys(PRIVACY).map(game => ({ params: { game }, props: { gameId: game } })); }
const { gameId } = Astro.props;
---
<PolicyPage lang="en" gameId={gameId} />
