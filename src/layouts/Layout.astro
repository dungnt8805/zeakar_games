---
import '../styles/global.css';
import { type Locale, UI_TRANSLATIONS, LOCALES, HTML_LANG, localizedPath, unlocalizedPath } from '../i18n/ui';
import { ADSENSE_CLIENT } from '../data/ads';

interface Props {
	title?: string;
	description?: string;
	lang?: Locale;
	/** Load the AdSense script (only pages with a configured ad placement). */
	ads?: boolean;
	/** Social preview image (site-relative or absolute); defaults to the studio card. */
	image?: string;
	type?: 'website' | 'article';
}

const {
	lang = 'en',
	title = 'Milaan (Lamian Games) | Google Play Mobile Game Developer',
	description = 'Milaan (Lamian Games) - Mobile game developer on Google Play.',
	ads = false,
	image = '/media/og-default.jpg',
	type = 'website',
} = Astro.props;
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', vi: 'vi_VN', zh: 'zh_CN', fr: 'fr_FR', th: 'th_TH', ja: 'ja_JP', ko: 'ko_KR' };
const path = unlocalizedPath(Astro.url.pathname);
const canonical = new URL(localizedPath(lang, path), Astro.site);
const verification = import.meta.env.GOOGLE_SITE_VERIFICATION?.trim();
---

<!doctype html>
<html lang={HTML_LANG[lang]} class="scroll-smooth dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Milaan Games" />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site).href} />
		<meta property="og:locale" content={OG_LOCALE[lang]} />
		{LOCALES.filter(locale => locale !== lang).map(locale => <meta property="og:locale:alternate" content={OG_LOCALE[locale]} />)}
		<meta name="twitter:card" content="summary_large_image" />
		{LOCALES.map(locale => <link rel="alternate" hreflang={HTML_LANG[locale]} href={new URL(localizedPath(locale, path), Astro.site).href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site).href} />
		{Astro.url.pathname === '/' && verification && <meta name="google-site-verification" content={verification} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
			rel="stylesheet"
		/>
		{ads && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
		<slot name="head" />
	</head>
	<body class="min-h-screen bg-[#0a0c14] text-slate-100 antialiased font-sans selection:bg-amber-500 selection:text-black overflow-x-hidden">
		<a class="skip-link" href="#main-content">{UI_TRANSLATIONS[lang].page.skip}</a>
		<slot />
	</body>
</html>
