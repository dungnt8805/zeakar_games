---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { type Locale, UI_TRANSLATIONS, LOCALES, HTML_LANG, localizedPath, unlocalizedPath } from '../i18n/ui';
import { ADSENSE_CLIENT } from '../data/ads';

interface Props {
	title?: string;
	description?: string;
	lang?: Locale;
	/** Load the AdSense script (only pages with a configured ad placement). */
	ads?: boolean;
	/** Social preview image (site-relative or absolute); defaults to the studio card. */
	image?: string;
	type?: 'website' | 'article';
}

const {
	lang = 'en',
	title = 'Milaan (Lamian Games) | Google Play Mobile Game Developer',
	description = 'Milaan (Lamian Games) - Mobile game developer on Google Play.',
	ads = false,
	image = '/media/og-default.jpg',
	type = 'website',
} = Astro.props;
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', vi: 'vi_VN', zh: 'zh_CN', fr: 'fr_FR', th: 'th_TH', ja: 'ja_JP', ko: 'ko_KR' };
const path = unlocalizedPath(Astro.url.pathname);
const canonical = new URL(localizedPath(lang, path), Astro.site);
const verification = import.meta.env.GOOGLE_SITE_VERIFICATION?.trim();
---

<!doctype html>
<html lang={HTML_LANG[lang]} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#0a0c14" />
		<!-- Theme before first paint: stored choice ("milaan.theme") or the device preference. Colours match global.css. -->
		<script is:inline>
			(() => {
				const KEY = 'milaan.theme';
				const COLORS = { dark: '#0a0c14', light: '#f5f7fa', gold: '#0d0a06', honey: '#fdf5e2', sunflower: '#ffdd40' };
				const root = document.documentElement;
				const media = matchMedia('(prefers-color-scheme: light)');
				const known = value => Object.prototype.hasOwnProperty.call(COLORS, value);
				let memory = 'auto';
				const stored = () => {
					try { const value = localStorage.getItem(KEY); return known(value) ? value : 'auto'; } catch { return memory; }
				};
				const apply = (choice = stored()) => {
					const theme = choice === 'auto' ? (media.matches ? 'light' : 'dark') : choice;
					root.dataset.theme = theme;
					root.dataset.themeChoice = choice;
					document.querySelector('meta[name="theme-color"]')?.setAttribute('content', COLORS[theme]);
					document.dispatchEvent(new CustomEvent('milaan:theme', { detail: { choice, theme } }));
				};
				window.milaanTheme = {
					set(choice) {
						if (choice !== 'auto' && !known(choice)) return;
						memory = choice;
						try { choice === 'auto' ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, choice); } catch {}
						apply(choice);
					},
				};
				media.addEventListener('change', () => { if (stored() === 'auto') apply(); });
				addEventListener('storage', event => { if (event.key === KEY) apply(); });
				apply();
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Milaan Games" />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site).href} />
		<meta property="og:locale" content={OG_LOCALE[lang]} />
		{LOCALES.filter(locale => locale !== lang).map(locale => <meta property="og:locale:alternate" content={OG_LOCALE[locale]} />)}
		<meta name="twitter:card" content="summary_large_image" />
		{LOCALES.map(locale => <link rel="alternate" hreflang={HTML_LANG[locale]} href={new URL(localizedPath(locale, path), Astro.site).href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site).href} />
		{Astro.url.pathname === '/' && verification && <meta name="google-site-verification" content={verification} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
			rel="stylesheet"
		/>
		{ads && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
		<slot name="head" />
	</head>
	<body class="min-h-screen antialiased font-sans overflow-x-hidden">
		<a class="skip-link" href="#main-content">{UI_TRANSLATIONS[lang].page.skip}</a>
		<slot />
		<Analytics lang={lang} />
	</body>
</html>
