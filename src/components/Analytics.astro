---
import { localizedArcadePath, type Locale } from '../i18n/ui';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const labels = {
  en: ['Analytics', 'Allow usage measurement with Google Analytics to help improve our website? Games work with either choice.', 'Allow analytics', 'Decline', 'Privacy policy'],
  vi: ['Thống kê truy cập', 'Cho phép Google Analytics đo lượt truy cập và tương tác để cải thiện website? Bạn vẫn chơi được game với cả hai lựa chọn.', 'Cho phép thống kê', 'Từ chối', 'Chính sách riêng tư'],
  zh: ['访问统计', '允许 Google Analytics 衡量网站访问和互动以帮助改进网站吗？无论如何选择，游戏均可正常使用。', '允许统计', '拒绝', '隐私政策'],
  fr: ['Statistiques', 'Autoriser Google Analytics à mesurer les visites et interactions pour améliorer ce site ? Les jeux fonctionnent dans les deux cas.', 'Autoriser', 'Refuser', 'Confidentialité'],
  th: ['สถิติการเข้าชม', 'อนุญาตให้ Google Analytics วัดการเข้าชมและการโต้ตอบเพื่อปรับปรุงเว็บไซต์หรือไม่? เล่นเกมได้ไม่ว่าจะเลือกแบบใด', 'อนุญาต', 'ปฏิเสธ', 'นโยบายความเป็นส่วนตัว'],
  ja: ['アクセス解析', 'サイト改善のため Google Analytics による訪問と操作の計測を許可しますか？どちらを選んでもゲームは利用できます。', '許可する', '拒否する', 'プライバシーポリシー'],
  ko: ['방문 통계', '사이트 개선을 위해 Google Analytics의 방문 및 상호작용 측정을 허용하시겠습니까? 어느 쪽을 선택해도 게임을 이용할 수 있습니다.', '허용', '거부', '개인정보처리방침'],
}[lang];
---
<div id="site-analytics" data-measurement-id="G-VGWV9V79S8">
  <button id="analytics-settings" class="analytics-settings" type="button" aria-controls="analytics-choice" aria-expanded="false" hidden>{labels[0]}</button>
  <section id="analytics-choice" class="analytics-choice" aria-label={labels[0]} hidden>
    <p>{labels[1]}</p>
    <div>
      <button type="button" data-analytics-choice="granted">{labels[2]}</button>
      <button type="button" data-analytics-choice="denied">{labels[3]}</button>
      <a href={localizedArcadePath(lang, 'privacy')}>{labels[4]}</a>
    </div>
  </section>
</div>
<script>
  import { initializeAnalytics } from '../lib/analytics';
  initializeAnalytics();
</script>
<style>
  .analytics-settings { position: fixed; bottom: 10px; left: 10px; z-index: 70; border: 1px solid #64748b; border-radius: 8px; background: #111827; color: #e2e8f0; padding: 8px 12px; font-size: 12px; }
  .analytics-choice { position: fixed; bottom: 12px; left: 12px; right: 12px; margin: 0 auto; max-width: 680px; z-index: 80; padding: 18px; border: 1px solid #64748b; border-radius: 14px; background: #111827; color: #f1f5f9; box-shadow: 0 8px 40px #0009; font-size: 14px; line-height: 1.6; }
  .analytics-choice div { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 12px; }
  .analytics-choice button { padding: 8px 14px; border: 1px solid #94a3b8; border-radius: 8px; min-height: 44px; }
  .analytics-choice button:first-child { background: #fbbf24; color: #111827; border-color: #fbbf24; }
  .analytics-choice a { text-decoration: underline; }
  button { cursor: pointer; }
  [hidden] { display: none !important; }
</style>
