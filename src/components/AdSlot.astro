---
import { ADSENSE_CLIENT, AD_SLOTS, hasAd, type AdPlacement } from '../data/ads';
import { UI_TRANSLATIONS, type Locale } from '../i18n/ui';

interface Props { lang: Locale; placement: AdPlacement; class?: string; }
const { lang, placement, class: className = '' } = Astro.props;
---

{hasAd(placement) && (
  <aside class={`ad-slot ${className}`} aria-label={UI_TRANSLATIONS[lang].arcade.adLabel}>
    <span class="ad-label">{UI_TRANSLATIONS[lang].arcade.adLabel}</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={AD_SLOTS[placement]}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style>
  /* Reserve space so the page doesn't jump when the ad loads; collapse when nothing is served. */
  .ad-slot { display: grid; gap: 6px; min-height: 120px; padding: 12px; border: 1px dashed var(--line); border-radius: 16px; background: var(--surface-low); }
  .ad-slot:has(ins[data-ad-status="unfilled"]) { display: none; }
  .ad-label { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--text-dim); }

</style>
