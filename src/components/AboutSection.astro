---
import type { Locale } from '../i18n/ui';
import { UI_TRANSLATIONS } from '../i18n/ui';
import { getStudioInfo } from '../data/games';

interface Props {
	lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = UI_TRANSLATIONS[lang].about;
const studioInfo = getStudioInfo(lang);
---

<section id="about" class="py-14 sm:py-24 relative overflow-hidden">
	{/* Background ambient lighting */}
	<div class="absolute -bottom-40 right-0 w-96 h-96 bg-indigo-600/10 blur-[120px] rounded-full pointer-events-none"></div>

	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		{/* Section Intro */}
		<div class="text-center max-w-3xl mx-auto mb-16">
			<div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3.5 py-1 text-xs font-semibold text-amber-400 mb-3">
				{t.badge}
			</div>
			<h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display">
				{t.title}
			</h2>
			<p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
				{studioInfo.description}
			</p>
		</div>

		{/* Grid of Values & Pillars */}
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 mb-20">
			<div class="p-6 sm:p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 hover:border-amber-500/40 transition">
				<div class="h-12 w-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-2xl font-bold mb-6">
					⚡
				</div>
				<h3 class="text-lg sm:text-xl font-bold text-white mb-2 font-display">{t.pillar1Title}</h3>
				<p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
					{t.pillar1Desc}
				</p>
			</div>

			<div class="p-6 sm:p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 hover:border-rose-500/40 transition">
				<div class="h-12 w-12 rounded-2xl bg-rose-500/10 text-rose-400 flex items-center justify-center text-2xl font-bold mb-6">
					🎨
				</div>
				<h3 class="text-lg sm:text-xl font-bold text-white mb-2 font-display">{t.pillar2Title}</h3>
				<p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
					{t.pillar2Desc}
				</p>
			</div>

			<div class="p-6 sm:p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 hover:border-sky-500/40 transition">
				<div class="h-12 w-12 rounded-2xl bg-sky-500/10 text-sky-400 flex items-center justify-center text-2xl font-bold mb-6">
					🌍
				</div>
				<h3 class="text-lg sm:text-xl font-bold text-white mb-2 font-display">{t.pillar3Title}</h3>
				<p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
					{t.pillar3Desc}
				</p>
			</div>
		</div>

		{/* Studio Milestones */}
		<div class="rounded-3xl bg-gradient-to-br from-slate-900/80 via-slate-900/50 to-slate-950/90 border border-slate-800 p-6 sm:p-12">
			<h3 class="text-2xl font-bold text-white font-display text-center mb-10">
				{t.timelineTitle}
			</h3>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{
					studioInfo.milestones.map((milestone) => (
						<div class="relative p-6 rounded-2xl bg-slate-950/70 border border-slate-800 flex flex-col justify-between">
							<div>
								<span class="text-xs font-bold text-amber-400 uppercase tracking-widest">{milestone.year}</span>
								<h4 class="text-base font-bold text-white mt-1 mb-2 font-display">{milestone.title}</h4>
								<p class="text-xs text-slate-400 leading-relaxed">{milestone.desc}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
