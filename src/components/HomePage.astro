---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StudioStats from '../components/StudioStats.astro';
import { GameExplorer } from '../components/GameExplorer';
import AboutSection from '../components/AboutSection.astro';
import Footer from '../components/Footer.astro';
import { getGames } from '../data/games';

import type { Locale } from '../i18n/ui';
import { UI_TRANSLATIONS } from '../i18n/ui';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const games = getGames(lang);
const t = UI_TRANSLATIONS[lang];
---

<Layout
	lang={lang}
	title={`Milaan Games | ${t.nav.games}`}
	description={t.footer.desc}
>
	<Navbar lang={lang} />

	<main id="main-content" tabindex="-1" class="relative z-10 space-y-14 sm:space-y-20">
		<Hero lang={lang} />
		<StudioStats lang={lang} />
		<div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
			<GameExplorer games={games} lang={lang} client:load />
		</div>
		<AboutSection lang={lang} />
	</main>

	<Footer lang={lang} />
</Layout>
