---
import type { Locale } from '../i18n/ui';
import { localizedPath, UI_TRANSLATIONS } from '../i18n/ui';
import { StoreButtons } from './StoreButtons';

interface Props {
	lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = UI_TRANSLATIONS[lang].footer;
---

<footer class="border-t border-slate-800 bg-[#07090e] text-slate-400 text-sm">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 sm:gap-10 mb-12">
			{/* Brand column */}
			<div class="sm:col-span-2 space-y-4">
				<div class="flex items-center gap-3">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 via-rose-500 to-indigo-600 p-[1px]">
						<div class="flex h-full w-full items-center justify-center rounded-xl bg-slate-950">
							<svg class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<line x1="6" x2="10" y1="12" y2="12"></line>
								<line x1="8" x2="8" y1="10" y2="14"></line>
								<line x1="15" x2="15.01" y1="13" y2="13"></line>
								<line x1="18" x2="18.01" y1="11" y2="11"></line>
								<rect width="20" height="12" x="2" y="6" rx="6"></rect>
							</svg>
						</div>
					</div>
					<span class="text-xl font-bold tracking-tight text-white font-display">
						MILAAN <span class="text-amber-400">GAMES</span>
					</span>
				</div>
				<p class="text-xs text-slate-400 leading-relaxed max-w-sm">
					{t.desc}
				</p>
				<div class="pt-2">
					<StoreButtons lang={lang} googlePlayUrl="https://play.google.com/store/apps/developer?id=Milaan" size="sm" client:visible />
				</div>
			</div>

			{/* Column 2: Danh mục Games */}
			<div class="space-y-3">
				<h4 class="text-xs uppercase tracking-wider font-bold text-white">{t.categoriesTitle}</h4>
				<ul class="space-y-2 text-xs">
					<li><a href="#games" class="hover:text-amber-400 transition cursor-pointer">{t.catShooter}</a></li>
					<li><a href="#games" class="hover:text-amber-400 transition cursor-pointer">{t.catBlock}</a></li>
					<li><a href="#games" class="hover:text-amber-400 transition cursor-pointer">{t.catFood}</a></li>
					<li><a href="#games" class="hover:text-amber-400 transition cursor-pointer">{t.catMatch3}</a></li>
					<li><a href="#games" class="hover:text-amber-400 transition cursor-pointer">{t.catBrain}</a></li>
				</ul>
			</div>

			{/* Column 3: Về Studio */}
			<div class="space-y-3">
				<h4 class="text-xs uppercase tracking-wider font-bold text-white">{t.devTitle}</h4>
				<ul class="space-y-2 text-xs">
					<li><a href="https://play.google.com/store/apps/developer?id=Milaan" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline cursor-pointer">{t.chPlayProfile}</a></li>
					<li><a href="#about" class="hover:text-amber-400 transition cursor-pointer">{t.aboutStudio}</a></li>
					<li><a href="#featured" class="hover:text-amber-400 transition cursor-pointer">{t.featuredGames}</a></li>
					<li><a href="#stats" class="hover:text-amber-400 transition cursor-pointer">{t.milestones}</a></li>
				</ul>
			</div>

			{/* Column 4: Hỗ Trợ & Pháp Lý */}
			<div class="space-y-3">
				<h4 class="text-xs uppercase tracking-wider font-bold text-white">{t.supportTitle}</h4>
				<ul class="space-y-2 text-xs">
					<li><a href="#" class="hover:text-amber-400 transition cursor-pointer">{t.helpCenter}</a></li>
					<li><a href={localizedPath(lang, '/policies')} class="hover:text-amber-400 transition cursor-pointer">{t.privacy}</a></li>
					<li><a href={`${localizedPath(lang, '/policies')}#terms`} class="hover:text-amber-400 transition cursor-pointer">{t.terms}</a></li>
					<li><a href={localizedPath(lang, '/policies')} class="hover:text-amber-400 transition cursor-pointer">{t.coppa}</a></li>
					<li><a href="mailto:support@lamianstudio.com" class="text-amber-400 hover:underline cursor-pointer">support@lamianstudio.com</a></li>
				</ul>
			</div>
		</div>

		{/* Copyright Bar */}
		<div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 text-center sm:text-left">
			<p>© {new Date().getFullYear()} {t.rights}</p>
			<p class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
				<span>{t.googleNotice}</span>
				<span>•</span>
				<span>{t.appleNotice}</span>
			</p>
		</div>
	</div>
</footer>
