---
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import PRIVACY from '../data/privacy-translations.json';
import { getGames } from '../data/games';
import { type Locale, localizedPath, UI_TRANSLATIONS } from '../i18n/ui';
interface Props { lang: Locale; gameId: keyof typeof PRIVACY; }
const { lang, gameId } = Astro.props;
const policy = PRIVACY[gameId];
const game = getGames(lang).find(game => game.id === gameId)!;
const t = UI_TRANSLATIONS[lang].policy;
---
<Layout lang={lang} title={`${game.title} | ${t.title}`} description={`${game.title} — ${t.title}`}>
  <header class="site-header"><div class="header-inner"><a class="studio-brand" href={localizedPath(lang)}>MILAAN<span class="brand-subtitle">GAMES</span></a><LanguageSwitcher currentLang={lang} /></div></header>
  <main id="main-content" tabindex="-1" class="mx-auto max-w-4xl px-5 sm:px-8 py-10 sm:py-16">
    <a class="text-sm text-slate-400 hover:text-amber-400" href={localizedPath(lang,'/policies')}>← {t.title}</a>
    <h1 class="section-title mt-8">{game.title}</h1>
    <p class="mt-3 text-sm text-amber-400">{t.title}</p>
    {lang !== 'en' && <p class="mt-5 rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-xs leading-relaxed text-slate-400">{t.translationNote}</p>}
    <a href={policy.originalUrl} class="mt-5 inline-block text-sm text-amber-400 underline underline-offset-4">{t.original} ↗</a>
    <article class="policy-content mt-10" set:html={policy.locales[lang]} />
    <div class="mt-10 border-t border-slate-800 pt-6"><a class="text-sm text-amber-400 underline" href={policy.termsUrl}>{t.terms} ↗</a></div>
  </main>
</Layout>
