---
import type { Locale } from '../i18n/ui';

interface Props { lang: Locale; title: string; }
const { lang, title } = Astro.props;
const labels = {
  en: { play: 'Play in browser', close: 'Close demo', hint: 'Drag with your mouse or finger to steer. The ship fires automatically.' },
  vi: { play: 'Chơi thử trên web', close: 'Đóng bản chơi thử', hint: 'Giữ và kéo chuột hoặc ngón tay để lái. Tàu tự động bắn.' },
  zh: { play: '在浏览器中试玩', close: '关闭试玩', hint: '用鼠标或手指拖动来操控飞船。飞船会自动开火。' },
  fr: { play: 'Jouer dans le navigateur', close: 'Fermer la démo', hint: 'Faites glisser la souris ou votre doigt pour piloter. Le vaisseau tire automatiquement.' },
  th: { play: 'เล่นบนเบราว์เซอร์', close: 'ปิดเดโม', hint: 'ลากเมาส์หรือนิ้วเพื่อบังคับยาน ยานจะยิงโดยอัตโนมัติ' },
  ja: { play: 'ブラウザーで試遊', close: '体験版を閉じる', hint: 'マウスや指でドラッグして機体を操作します。射撃は自動です。' },
  ko: { play: '브라우저에서 체험하기', close: '체험판 닫기', hint: '마우스나 손가락으로 드래그해 조종하세요. 기체가 자동으로 발사합니다.' },
};
const t = labels[lang];
const src = `/playable/aster-strike/index.html?lang=${lang === 'vi' ? 'vi' : 'en'}`;
---

<section aria-labelledby="aster-playable-title" class="space-y-4 rounded-3xl border border-amber-400/25 bg-slate-900/70 p-5 sm:p-8">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 id="aster-playable-title" class="font-display text-2xl font-bold text-white">{t.play}</h2>
      <p class="mt-2 text-sm text-slate-300">{t.hint}</p>
    </div>
    <button type="button" id="aster-playable-start" class="primary-action" aria-controls="aster-playable-frame" hidden>
      <span aria-hidden="true">▶</span> {t.play}
    </button>
    <button type="button" id="aster-playable-close" class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-white hover:border-amber-400" aria-controls="aster-playable-frame" hidden>
      {t.close}
    </button>
    <noscript><a href={src} class="text-amber-400 underline">{t.play} ↗</a></noscript>
  </div>
  <div id="aster-playable-frame" hidden></div>
  <template id="aster-playable-template">
    <iframe
      src={src}
      title={`${title} — ${t.play}`}
      sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
      class="mx-auto block aspect-[9/16] w-[min(100%,42.75svh,383px)] rounded-2xl border border-slate-700 bg-slate-950"
    ></iframe>
  </template>
</section>

<script>
  const start = document.querySelector<HTMLButtonElement>('#aster-playable-start');
  const close = document.querySelector<HTMLButtonElement>('#aster-playable-close');
  const frame = document.querySelector('#aster-playable-frame');
  const template = document.querySelector<HTMLTemplateElement>('#aster-playable-template');

  if (start && close && frame && template) {
    start.hidden = false;
    start.addEventListener('click', () => {
      frame.replaceChildren(template.content.cloneNode(true));
      frame.hidden = false;
      start.hidden = true;
      close.hidden = false;
      close.focus({ preventScroll: true });
      frame.scrollIntoView({ block: 'nearest' });
    });

    close.addEventListener('click', () => {
      frame.replaceChildren();
      frame.hidden = true;
      close.hidden = true;
      start.hidden = false;
      start.focus();
    });
  }
</script>
