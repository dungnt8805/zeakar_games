---
import type { Locale } from '../i18n/ui';
import { getStudioInfo } from '../data/games';

interface Props {
	lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const studioInfo = getStudioInfo(lang);
---

<section id="stats" class="py-6 sm:py-7 border-y border-slate-800/80 bg-slate-950/40 relative">
	<div class="mx-auto max-w-7xl px-3 sm:px-6 lg:px-8">
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6 lg:gap-8">
			{
				studioInfo.stats.map((stat) => (
					<div class="flex flex-col items-center text-center p-3 sm:p-4 transition group">
						<span class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white font-display tracking-tight group-hover:scale-105 transition-transform duration-300">
							{stat.value}
						</span>
						<span class="mt-1.5 sm:mt-2 text-[10px] sm:text-xs md:text-sm font-medium text-slate-400 uppercase tracking-wider">
							{stat.label}
						</span>
					</div>
				))
			}
		</div>
	</div>
</section>
