---
import type { Locale } from '../i18n/ui';
import { UI_TRANSLATIONS } from '../i18n/ui';
import { getGames } from '../data/games';
interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const t = UI_TRANSLATIONS[lang].page;
const games = getGames(lang).filter(game => game.featured).slice(0, 3);
---
<section class="studio-hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> MILAAN / {t.studio}</p>
      <h1 id="hero-title">{t.line1}<br /><span>{t.line2}</span></h1>
      <p class="hero-description">{t.description}</p>
      <div class="hero-actions">
        <a href="#games" class="primary-action">{t.explore} <span aria-hidden="true">↗</span></a>
        <a href="#featured" class="text-action">{t.favorites} <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-footnote"><div class="hero-icons">{games.map(game => <img src={game.icon} alt="" width="36" height="36" />)}</div><span>{t.genres}<br /><strong>{t.discover}</strong></span></div>
    </div>
    <div class="hero-art">
      <div class="hero-orbit" aria-hidden="true"></div>
      <span class="art-note" aria-hidden="true">{t.artNote}</span>
      <div class="hero-phones">{games.map((game, i) => <a href="#featured" class={`hero-phone phone-${i}`} aria-label={`${t.view} ${game.title}`}><img src={game.banner} alt={game.title} width="270" height="480" fetchpriority={i === 1 ? 'high' : 'auto'} /><span>{game.title.split(':')[0]} <span aria-hidden="true">↗</span></span></a>)}</div>
      <div class="art-caption"><span class="status-dot"></span>{t.caption}<span aria-hidden="true">✦</span></div>
    </div>
  </div>
</section>
