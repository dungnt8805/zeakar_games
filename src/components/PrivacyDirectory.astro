---
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getGames } from '../data/games';
import PRIVACY from '../data/privacy-translations.json';
import { localizedPath, localizedPolicyPath, UI_TRANSLATIONS, type Locale } from '../i18n/ui';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = UI_TRANSLATIONS[lang].policy;
const games = getGames(lang);
---
<Layout lang={lang} title={`${t.title} | Milaan Games`} description={t.description}>
  <header class="site-header"><div class="header-inner"><a href={localizedPath(lang)} class="studio-brand"><span class="brand-symbol" aria-hidden="true">m<span>✦</span></span><span>MILAAN<span class="brand-subtitle">GAMES STUDIO</span></span></a><LanguageSwitcher currentLang={lang} /></div></header>
  <main id="main-content" tabindex="-1" class="mx-auto max-w-4xl px-5 sm:px-8 py-12 sm:py-20">
    <a href={localizedPath(lang)} class="inline-flex py-2 text-sm text-slate-400 hover:text-amber-400">← {t.back}</a>
    <div class="mt-8 mb-10"><span class="section-kicker">MILAAN GAMES</span><h1 class="section-title">{t.title}</h1><p class="section-description">{t.description}</p><p class="mt-3 text-xs leading-relaxed text-slate-400">{t.note}</p></div>
    <ul class="grid gap-3 sm:gap-4">{games.map(game => <li class="rounded-2xl border border-slate-800 bg-slate-900/50 p-4 sm:p-5"><a href={localizedPolicyPath(lang,game.id)} class="flex items-center gap-4 hover:text-amber-400"><img src={game.icon} alt="" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-xl shrink-0" /><span class="min-w-0 flex-1"><span class="block font-semibold text-sm sm:text-base">{game.title}</span><span class="block mt-1 text-xs text-slate-400">{t.read}</span></span><span aria-hidden="true" class="text-amber-400">→</span></a><a href={game.privacyUrl} class="mt-3 inline-flex text-xs text-slate-400 underline underline-offset-4 hover:text-amber-400">{t.original} ↗</a></li>)}</ul>
    <section id="terms" class="mt-12 border-t border-slate-800 pt-8"><h2 class="text-lg font-semibold">{t.terms}</h2><ul class="mt-4 grid gap-3 text-sm text-slate-300">{games.map(game => <li><a class="underline underline-offset-4 hover:text-amber-400" href={PRIVACY[game.id as keyof typeof PRIVACY].termsUrl}>{game.title} ↗</a></li>)}</ul></section>
    <p class="mt-10 border-t border-slate-800 pt-6 text-xs text-slate-400">© {new Date().getFullYear()} Milaan Games</p>
  </main>
</Layout>
