---
import { LOCALES, LANGUAGE_NAMES, HTML_LANG, localizedPath, UI_TRANSLATIONS, type Locale } from '../i18n/ui';
interface Props { currentLang?: Locale; className?: string; }
const { currentLang = 'en', className = '' } = Astro.props;
const segments = Astro.url.pathname.split('/').filter(Boolean);
if (LOCALES.includes(segments[0] as Locale)) segments.shift();
const path = segments.length ? '/' + segments.join('/') : '/';
---
<details class={`language-picker ${className}`}>
  <summary aria-label={UI_TRANSLATIONS[currentLang].page.language}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c5 5 5 13 0 18M12 3c-5 5-5 13 0 18" /></svg><span>{LANGUAGE_NAMES[currentLang]}</span><span aria-hidden="true">⌄</span></summary>
  <nav aria-label={UI_TRANSLATIONS[currentLang].page.language}>{LOCALES.map(locale => <a href={localizedPath(locale,path)} lang={HTML_LANG[locale]} hreflang={HTML_LANG[locale]} aria-current={locale===currentLang ? 'page' : undefined}>{LANGUAGE_NAMES[locale]}<span aria-hidden="true">{locale===currentLang ? '✓' : ''}</span></a>)}</nav>
</details>
<script>
for (const picker of document.querySelectorAll<HTMLDetailsElement>('.language-picker')) {
 document.addEventListener('click', event => { if (!picker.contains(event.target as Node)) picker.open = false; });
 picker.addEventListener('keydown', event => { if (event.key === 'Escape') { picker.open = false; picker.querySelector('summary')?.focus(); } });
}
</script>
