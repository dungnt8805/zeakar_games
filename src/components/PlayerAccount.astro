---
/** Header player button plus the sign-in / sign-up / verify / reset dialog, available on every page with a Navbar. */
import type { Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/ui';
import PLAYER from '../i18n/player.json';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const p = PLAYER[lang];
---
<a href={localizedPath(lang, '/profile/')} class="player-btn" id="player-btn" data-signed-out>
  <span class="player-avatar" aria-hidden="true">👤</span>
  <span class="player-name">{p.signIn}</span>
</a>

<dialog id="auth-dialog" class="auth-dialog" aria-labelledby="auth-title">
  <div class="auth-card">
    <form method="dialog" class="auth-close"><button aria-label={p.close}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button></form>

    <header class="auth-head">
      <span class="auth-badge" id="auth-badge" aria-hidden="true">🎮</span>
      <h2 id="auth-title"></h2>
      <p id="auth-text" class="auth-text"></p>
    </header>

    <div class="auth-tabs" role="tablist" id="auth-tabs">
      <button type="button" role="tab" data-tab="login">{p.signIn}</button>
      <button type="button" role="tab" data-tab="signup">{p.createAccount}</button>
    </div>

    <ul class="auth-perks" id="auth-perks">
      <li><span aria-hidden="true">☁️</span>{p.benefitSync}</li>
      <li><span aria-hidden="true">🏆</span>{p.benefitRank}</li>
      <li><span aria-hidden="true">✨</span>{p.benefitProfile}</li>
    </ul>

    <form id="auth-form" class="auth-form" novalidate>
      <label class="field" data-field="email">
        <span class="field-label">{p.email}</span>
        <span class="field-box">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M4 7l8 6 8-6" /></svg>
          <input name="email" type="email" autocomplete="email" required maxlength="254" placeholder={p.emailPlaceholder} />
        </span>
      </label>

      <label class="field" data-field="code">
        <span class="field-label">{p.code}</span>
        <input class="code-input" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="••••••" />
        <small class="field-hint">{p.checkSpam}</small>
      </label>

      <label class="field" data-field="password">
        <span class="field-label" id="password-label">{p.password}</span>
        <span class="field-box">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
          <input name="password" type="password" autocomplete="current-password" minlength="8" maxlength="200" />
          <button type="button" class="peek" id="peek" aria-label={p.showPassword} aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
          </button>
        </span>
        <small class="field-hint" id="password-hint">{p.passwordHint}</small>
      </label>

      <label class="field" data-field="nickname">
        <span class="field-label">{p.nickname} <em>· {p.optional}</em></span>
        <span class="field-box">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
          <input name="nickname" autocomplete="nickname" maxlength="20" />
        </span>
        <small class="field-hint">{p.nicknameHint}</small>
      </label>

      <button type="button" class="link-btn forgot" data-go="forgot">{p.forgot}</button>

      <p id="auth-error" class="auth-msg" role="alert" hidden></p>

      <button type="submit" class="auth-submit" id="auth-submit"><span class="spinner" aria-hidden="true"></span><span id="auth-submit-label"></span></button>

      <div class="auth-foot">
        <button type="button" class="link-btn" data-go="resend">{p.resend}</button>
        <button type="button" class="link-btn" data-go="back">← {p.back}</button>
      </div>
    </form>

    <p class="auth-note" id="auth-note">{p.guestNote}</p>
  </div>
</dialog>

<script type="application/json" id="player-i18n" set:html={JSON.stringify(p)} />

<script>
  import { AVATARS, api, cachedPlayer, loadProfile, setCachedPlayer, type PlayerProfile } from '../lib/player-client';

  type Step = 'login' | 'signup' | 'verify' | 'forgot' | 'reset';
  const t = JSON.parse(document.getElementById('player-i18n')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const button = $('player-btn') as HTMLAnchorElement;
  const dialog = $('auth-dialog') as HTMLDialogElement;
  const form = $('auth-form') as HTMLFormElement;
  const message = $('auth-error');
  const submit = $('auth-submit') as HTMLButtonElement;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

  const render = (player: PlayerProfile['player'] | null) => {
    button.toggleAttribute('data-signed-out', !player);
    button.querySelector('.player-avatar')!.textContent = player ? AVATARS[player.avatar] ?? '🙂' : '👤';
    button.querySelector('.player-name')!.textContent = player ? player.nickname : t.signIn;
    button.title = player ? t.accountFor.replace('{name}', player.nickname) : t.signIn;
  };
  render(cachedPlayer());
  window.addEventListener('lamian:player', event => render((event as CustomEvent).detail));
  // Refresh quietly so a session that expired elsewhere shows as signed out.
  if (cachedPlayer()) loadProfile().catch(() => {});

  interface StepView { badge: string; title: string; text: string; submit: string; fields: string[]; links: string[]; tabs?: boolean }
  const STEPS: Record<Step, StepView> = {
    login: { badge: '🎮', title: t.signInTitle, text: t.signInText, submit: t.signIn, fields: ['email', 'password'], links: ['forgot'], tabs: true },
    signup: { badge: '🎮', title: t.signUpTitle, text: t.signInText, submit: t.createAccount, fields: ['email', 'password', 'nickname'], links: [], tabs: true },
    verify: { badge: '📬', title: t.verifyTitle, text: t.verifyText, submit: t.verify, fields: ['code'], links: ['resend', 'back'] },
    forgot: { badge: '🔑', title: t.resetTitle, text: t.resetText, submit: t.sendCode, fields: ['email'], links: ['back'] },
    reset: { badge: '🔑', title: t.resetTitle, text: t.verifyText, submit: t.setPassword, fields: ['code', 'password'], links: ['resend', 'back'] },
  };
  let step: Step = 'login';
  let backTo: Step = 'login';

  const say = (text: string, kind: 'error' | 'info' = 'error') => {
    message.textContent = text;
    message.hidden = !text;
    message.dataset.kind = kind;
  };

  const show = (next: Step) => {
    if (next === 'login' || next === 'signup') backTo = next;
    step = next;
    const s = STEPS[next];
    dialog.dataset.step = next;
    $('auth-badge').textContent = s.badge;
    $('auth-title').textContent = s.title;
    // The email goes in as text, so a strange address can't inject markup.
    const [before, after = ''] = s.text.split('{email}');
    $('auth-text').replaceChildren(before, ...(s.text.includes('{email}') ? [Object.assign(document.createElement('strong'), { textContent: field('email').value }), after] : []));
    $('auth-submit-label').textContent = s.submit;
    $('auth-tabs').hidden = !s.tabs;
    $('auth-perks').hidden = next !== 'signup';
    $('auth-note').hidden = !s.tabs;
    $('auth-tabs').querySelectorAll<HTMLElement>('[data-tab]').forEach(tab => tab.setAttribute('aria-selected', String(tab.dataset.tab === next)));
    form.querySelectorAll<HTMLElement>('[data-field]').forEach(el => { el.hidden = !s.fields.includes(el.dataset.field!); });
    form.querySelectorAll<HTMLElement>('[data-go]').forEach(el => { el.hidden = !s.links.includes(el.dataset.go!); });
    $('password-label').textContent = next === 'reset' ? t.newPassword : t.password;
    $('password-hint').hidden = next === 'login';
    field('password').autocomplete = next === 'login' ? 'current-password' : 'new-password';
    if (next === 'verify' || next === 'reset') field('code').value = '';
    say('');
    // Focus the first empty field (e.g. the password when the email is already filled in).
    const inputs = [...form.querySelectorAll<HTMLInputElement>('[data-field]:not([hidden]) input')];
    requestAnimationFrame(() => (inputs.find(input => !input.value) ?? inputs[0])?.focus());
  };

  function openAuth(next: Step = 'login') {
    show(next);
    if (!dialog.open) dialog.showModal();
  }
  (window as any).lamianOpenAuth = openAuth;

  button.addEventListener('click', event => {
    if (cachedPlayer()) return; // signed in: the link goes to the profile page
    event.preventDefault();
    openAuth('login');
  });
  // Clicking the dimmed backdrop closes the dialog.
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  $('auth-tabs').querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(tab => tab.addEventListener('click', () => show(tab.dataset.tab as Step)));

  const peek = $('peek');
  peek.addEventListener('click', () => {
    const showing = field('password').type === 'text';
    field('password').type = showing ? 'password' : 'text';
    peek.setAttribute('aria-pressed', String(!showing));
    peek.setAttribute('aria-label', showing ? t.showPassword : t.hidePassword);
  });
  field('code').addEventListener('input', () => {
    field('code').value = field('code').value.replace(/\D/g, '').slice(0, 6);
    if (field('code').value.length === 6 && step === 'verify') form.requestSubmit();
  });

  const signedIn = (profile: PlayerProfile) => {
    setCachedPlayer(profile.player);
    dialog.close();
    form.reset();
  };

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (submit.disabled) return;
    const email = field('email').value.trim();
    const password = field('password').value;
    const code = field('code').value.trim();
    submit.disabled = true;
    submit.classList.add('is-busy');
    say('');
    try {
      if (step === 'login') signedIn(await api('/api/auth/login', { body: { email, password } }));
      else if (step === 'signup') { await api('/api/auth/signup', { body: { email, password, nickname: field('nickname').value.trim() } }); show('verify'); }
      else if (step === 'verify') signedIn(await api('/api/auth/verify', { body: { email, code } }));
      else if (step === 'forgot') { await api('/api/auth/forgot', { body: { email } }); show('reset'); }
      else if (step === 'reset') signedIn(await api('/api/auth/reset', { body: { email, code, password } }));
    } catch (err) {
      const codeName = (err as Error).message;
      if (codeName === 'unverified') { show('verify'); say(t.errors.unverified, 'info'); }
      else say(t.errors[codeName] ?? t.errors.server);
    } finally {
      submit.disabled = false;
      submit.classList.remove('is-busy');
    }
  });

  form.querySelectorAll<HTMLButtonElement>('[data-go]').forEach(link => link.addEventListener('click', async () => {
    const go = link.dataset.go!;
    if (go === 'back') return show(backTo);
    if (go !== 'resend') return show(go as Step);
    try {
      await api('/api/auth/resend', { body: { email: field('email').value.trim(), purpose: step === 'reset' ? 'reset' : 'verify' } });
      say(t.resent, 'info');
    } catch (err) {
      say(t.errors[(err as Error).message] ?? t.errors.server);
    }
  }));
</script>

<style>
  .player-btn { display: inline-flex; align-items: center; gap: 8px; max-width: 180px; padding: 6px 12px 6px 6px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 13px; font-weight: 600; color: var(--text-soft); white-space: nowrap; }
  .player-btn:hover { border-color: var(--accent-text); color: var(--accent-text); }
  .player-avatar { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--accent-soft); font-size: 16px; line-height: 1; }
  .player-name { overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 640px) { .player-btn { padding: 4px; } .player-name { display: none; } }

  /* Dialog: centred card on wide screens, bottom sheet on phones. */
  .auth-dialog { position: fixed; inset: 0; margin: auto; width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); padding: 0; border: 0; background: transparent; color: var(--text-body); overflow: visible; }
  .auth-dialog::backdrop { background: rgb(5 7 12 / .62); backdrop-filter: blur(6px); }
  .auth-dialog[open] .auth-card { animation: auth-in .22s cubic-bezier(.2, .8, .2, 1); }
  .auth-card { position: relative; max-height: calc(100dvh - 32px); overflow-y: auto; padding: 28px 28px 22px; border: 1px solid var(--line-popover); border-radius: 24px; background: linear-gradient(180deg, color-mix(in oklab, var(--accent) 9%, var(--surface-raised)) 0, var(--surface-raised) 150px); box-shadow: 0 40px 100px var(--shadow), 0 0 0 1px var(--line-faint) inset; }
  @keyframes auth-in { from { opacity: 0; transform: translateY(12px) scale(.98); } }
  @media (prefers-reduced-motion: reduce) { .auth-dialog[open] .auth-card { animation: none; } }
  @media (max-width: 560px) {
    .auth-dialog { width: 100%; max-width: none; margin: auto 0 0; max-height: 92dvh; }
    .auth-card { max-height: 92dvh; padding: 26px 20px calc(18px + env(safe-area-inset-bottom)); border-radius: 24px 24px 0 0; border-bottom: 0; }
    .auth-card::before { content: ''; position: absolute; top: 8px; left: 50%; width: 40px; height: 4px; margin-left: -20px; border-radius: 4px; background: var(--line-strong); }
    @keyframes auth-in { from { transform: translateY(40px); opacity: .4; } }
  }

  .auth-close { position: absolute; top: 14px; right: 14px; }
  .auth-close button { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 12px; color: var(--text-dim); }
  .auth-close button:hover { background: var(--surface-hover); color: var(--text-strong); }

  .auth-head { display: grid; justify-items: center; gap: 8px; text-align: center; }
  .auth-badge { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 18px; background: var(--accent-soft); border: 1px solid var(--accent-line); font-size: 28px; }
  .auth-head h2 { margin-top: 6px; padding: 0 28px; font: 700 22px/1.25 var(--font-display); letter-spacing: -.02em; color: var(--text-strong); }
  .auth-text { max-width: 34ch; font-size: 14px; line-height: 1.55; color: var(--text-muted); }
  .auth-text strong { color: var(--text-strong); font-weight: 600; overflow-wrap: anywhere; }

  .auth-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-top: 22px; padding: 4px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg); }
  .auth-tabs[hidden], .auth-perks[hidden], .auth-note[hidden] { display: none; }
  .auth-tabs button { padding: 9px 8px; border-radius: 10px; font-size: 14px; font-weight: 600; color: var(--text-dim); transition: background .15s, color .15s; }
  .auth-tabs button:hover { color: var(--text-strong); }
  .auth-tabs button[aria-selected="true"] { background: var(--surface-hover); color: var(--text-strong); box-shadow: 0 1px 3px var(--shadow-soft); }

  .auth-perks { display: grid; gap: 6px; margin-top: 16px; padding: 12px 14px; border-radius: 14px; background: var(--accent-soft); font-size: 13px; color: var(--text-soft); }
  .auth-perks li { display: flex; align-items: center; gap: 10px; }

  .auth-form { display: grid; gap: 14px; margin-top: 18px; }
  .field { display: grid; gap: 6px; }
  .field[hidden], .auth-form [hidden] { display: none; }
  .field-label { font-size: 13px; font-weight: 600; color: var(--text-soft); }
  .field-label em { font-style: normal; font-weight: 400; color: var(--text-dim); }
  .field-hint { font-size: 12px; line-height: 1.45; color: var(--text-dim); }
  .field-box { position: relative; display: flex; align-items: center; border: 1px solid var(--line-strong); border-radius: 12px; background: var(--surface); transition: border-color .15s, box-shadow .15s; }
  .field-box:focus-within { border-color: var(--accent-text); box-shadow: 0 0 0 3px var(--accent-soft); }
  .field-box > svg { flex-shrink: 0; width: 18px; height: 18px; margin-left: 13px; fill: none; stroke: var(--text-dim); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .field-box:focus-within > svg { stroke: var(--accent-text); }
  .field-box input { flex: 1; min-width: 0; padding: 12px 12px 12px 10px; border: 0; background: transparent; color: var(--text-strong); font: 500 15px var(--font-sans); outline: none; }
  .field-box input::placeholder, .code-input::placeholder { color: var(--text-dim); opacity: .7; }
  .peek { display: grid; place-items: center; width: 40px; height: 40px; margin-right: 2px; border-radius: 10px; color: var(--text-dim); }
  .peek:hover { color: var(--text-strong); }
  .peek svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .peek[aria-pressed="true"] { color: var(--accent-text); }
  .code-input { width: 100%; padding: 14px; border: 1px solid var(--line-strong); border-radius: 14px; background: var(--surface); color: var(--text-strong); font: 700 28px/1 var(--font-display); letter-spacing: .5em; text-indent: .5em; text-align: center; font-variant-numeric: tabular-nums; outline: none; }
  .code-input:focus { border-color: var(--accent-text); box-shadow: 0 0 0 3px var(--accent-soft); }

  .link-btn { justify-self: start; padding: 2px 0; font-size: 13px; font-weight: 500; color: var(--text-muted); }
  .link-btn:hover { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .forgot { justify-self: end; margin-top: -6px; }

  .auth-msg { padding: 10px 12px; border-radius: 12px; font-size: 13px; line-height: 1.45; }
  .auth-msg[data-kind="error"] { background: #ef44441a; border: 1px solid #ef444440; color: #fca5a5; }
  .auth-msg[data-kind="info"] { background: var(--accent-soft); border: 1px solid var(--accent-line); color: var(--accent-text); }
  :global(html[data-theme="light"]) .auth-msg[data-kind="error"] { color: #b91c1c; }

  .auth-submit { position: relative; display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 2px; padding: 13px; border-radius: 14px; background: var(--accent-fill); color: var(--on-accent); font-weight: 700; font-size: 15px; box-shadow: 0 8px 24px color-mix(in oklab, var(--accent) 28%, transparent); transition: background .15s, transform .1s; }
  .auth-submit:hover { background: var(--accent-hover-fill); }
  .auth-submit:active { transform: translateY(1px); }
  .auth-submit:disabled { cursor: progress; opacity: .75; }
  .spinner { display: none; width: 16px; height: 16px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .7s linear infinite; }
  .auth-submit.is-busy .spinner { display: block; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .auth-foot { display: flex; justify-content: space-between; gap: 12px; }
  .auth-foot:not(:has(> :not([hidden]))) { display: none; }
  .auth-note { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); text-align: center; font-size: 12px; line-height: 1.5; color: var(--text-dim); }
</style>
