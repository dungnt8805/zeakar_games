---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import ArcadeCard from './ArcadeCard.astro';
import AdSlot from './AdSlot.astro';
import { hasAd } from '../data/ads';
import { StoreButtons } from './StoreButtons';
import { ARCADE_GAMES, arcadeCover, playableUrl, type ArcadeGame } from '../data/arcade';
import { getGames } from '../data/games';
import CONTENT from '../i18n/arcade-games.json';
import { HTML_LANG, localizedArcadePath, localizedGamePath, localizedPath, UI_TRANSLATIONS, type Locale } from '../i18n/ui';
import { metaDescription, withBrand } from '../lib/seo';

interface Props { lang: Locale; game: ArcadeGame; }
const { lang, game } = Astro.props;
const t = UI_TRANSLATIONS[lang];
const a = t.arcade;
const text = a.games[game.id];
type Content = Record<string, Record<string, { intro: string; howTo: string[]; features: string[] }>>;
const content = (CONTENT as Content)[lang]?.[game.id] ?? (CONTENT as Content).en[game.id];
const store = game.gameId ? getGames(lang).find(entry => entry.id === game.gameId) : undefined;
const heading = a.playTitle.replace('{game}', game.title);
const title = withBrand(heading);
const pageUrl = new URL(localizedArcadePath(lang, game.id), Astro.site).href;
const cover = new URL(arcadeCover(game), Astro.site).href;
const others = ARCADE_GAMES.filter(entry => entry.id !== game.id);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.title,
    description: content.intro,
    url: pageUrl,
    image: cover,
    inLanguage: HTML_LANG[lang],
    genre: text.tag.split(' · ')[0],
    gamePlatform: 'Web browser',
    applicationCategory: 'Game',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    publisher: { '@type': 'Organization', name: 'Milaan Games', url: new URL('/', Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Milaan Games', item: new URL(localizedPath(lang), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t.nav.arcade, item: new URL(localizedArcadePath(lang), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: game.title, item: pageUrl },
    ],
  },
];
---

<Layout lang={lang} title={title} description={metaDescription(content.intro)} image={arcadeCover(game)} ads={hasAd('gameSidebar') || hasAd('gameBottom')}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <Navbar lang={lang} />

  <main id="main-content" tabindex="-1" class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-12">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href={localizedPath(lang)}>{t.page.home}</a></li>
        <li><a href={localizedArcadePath(lang)}>{t.nav.arcade}</a></li>
        <li aria-current="page">{game.title}</li>
      </ol>
    </nav>

    <div class:list={['play-layout', !game.portraitOnly && 'is-wide']}>
      <header class="play-head">
        <p class="section-kicker">{text.tag}</p>
        <h1 class="section-title">{heading}</h1>
      </header>

      <div class="play-stage">
        <div class="play-frame" id="play-frame" data-portrait={game.portraitOnly ? '' : undefined}>
          <div class="play-bar">
            <span>{game.title}</span>
            <button type="button" id="play-exit">{a.exitFullscreen} <span aria-hidden="true">✕</span></button>
          </div>
          <iframe src={playableUrl(game, lang)} title={game.title} sandbox={game.sandbox} allow="fullscreen"></iframe>
          {game.portraitOnly && (
            <div class="rotate-hint" role="status">
              <svg viewBox="0 0 48 48" width="56" height="56" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="15" y="6" width="18" height="32" rx="3"/><path d="M22 33h4"/><path d="M38 20a14 14 0 0 1-4 14m0 0v-5m0 5h-5"/></svg>
              <p>{a.rotateHint}</p>
            </div>
          )}
        </div>
        <button type="button" class="play-tool" id="play-fullscreen"><span aria-hidden="true">⛶</span> {a.fullscreen}</button>
      </div>

      <div class="play-info">
        <p class="play-intro">{content.intro}</p>
        <section aria-labelledby="how-to-title">
          <h2 id="how-to-title" class="play-subtitle">{a.howToTitle}</h2>
          <ol class="play-steps">{content.howTo.map(step => <li>{step}</li>)}</ol>
        </section>
        <section aria-labelledby="features-title">
          <h2 id="features-title" class="play-subtitle">{a.featuresTitle}</h2>
          <ul class="play-features">{content.features.map(feature => <li>{feature}</li>)}</ul>
        </section>
        <p class="text-xs text-slate-400">{a.tip} · <a href={localizedArcadePath(lang, 'privacy')} class="underline underline-offset-4 hover:text-amber-400">{t.footer.privacy}</a></p>
        <AdSlot lang={lang} placement="gameSidebar" />
        {store && (
          <section class="play-store" aria-labelledby="full-game-title">
            <div class="flex items-center gap-4">
              <img src={store.icon} alt="" width="56" height="56" class="h-14 w-14 rounded-xl" loading="lazy" />
              <div>
                <h2 id="full-game-title" class="text-base font-semibold text-white"><a href={localizedGamePath(lang, store.id)} class="hover:text-amber-400">{a.getFull}: {store.title}</a></h2>
                <p class="mt-1 text-sm text-slate-400">{a.fullGameText.replace('{app}', store.title)}</p>
              </div>
            </div>
            <StoreButtons lang={lang} googlePlayUrl={store.googlePlayUrl} appStoreUrl={store.appStoreUrl} size="sm" />
          </section>
        )}
      </div>
    </div>

    <AdSlot lang={lang} placement="gameBottom" class="mt-16" />

    <section class="mt-16" aria-labelledby="more-games-title">
      <h2 id="more-games-title" class="section-title">{a.moreGames}</h2>
      <ul class="more-grid mt-6" role="list">
        {others.map(entry => <ArcadeCard lang={lang} game={entry} heading="h3" />)}
      </ul>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<script>
  const frame = document.querySelector<HTMLElement>('#play-frame');
  const enter = document.querySelector<HTMLButtonElement>('#play-fullscreen');
  const exit = document.querySelector<HTMLButtonElement>('#play-exit');
  const iframe = frame?.querySelector('iframe');

  if (frame && enter && exit && iframe) {
    // CSS "immersive" mode works everywhere, including iPhone Safari where element fullscreen is unavailable.
    const setImmersive = (on: boolean) => {
      if (frame.classList.contains('is-immersive') === on) return;
      frame.classList.toggle('is-immersive', on);
      document.documentElement.classList.toggle('play-locked', on);
      (on ? iframe : enter).focus({ preventScroll: true });
    };
    // Portrait-only games: on phones, go truly fullscreen and lock the screen upright where the browser allows it (Android).
    // iOS cannot lock orientation, so the rotate hint in CSS covers that case.
    const lockPortrait = async () => {
      if (!('portrait' in frame.dataset) || !matchMedia('(pointer: coarse)').matches) return;
      try {
        await document.documentElement.requestFullscreen?.();
        await (screen.orientation as ScreenOrientation & { lock?: (o: string) => Promise<void> }).lock?.('portrait');
      } catch {}
    };
    enter.addEventListener('click', () => { setImmersive(true); lockPortrait(); });
    exit.addEventListener('click', () => {
      setImmersive(false);
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    });
    // Leaving real fullscreen (Android back button) also leaves immersive mode.
    document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement) setImmersive(false); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') setImmersive(false); });
    // Keys typed inside a same-origin game never reach this document, so listen there too.
    const forwardEscape = () => {
      try { iframe.contentDocument?.addEventListener('keydown', event => { if (event.key === 'Escape') setImmersive(false); }); } catch {}
    };
    iframe.addEventListener('load', forwardEscape);
    if (iframe.contentDocument?.readyState === 'complete') forwardEscape();
  }
</script>

<style>
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; color: var(--text-dim); }
  .breadcrumb li + li::before { content: '/'; margin-right: 6px; opacity: .5; }
  .breadcrumb a:hover { color: var(--accent-text); }
  .breadcrumb [aria-current] { color: var(--text-soft); }

  .play-layout { display: grid; grid-template-areas: "head" "stage" "info"; gap: 20px; margin-top: 16px; }
  .play-head { grid-area: head; }
  .play-stage { grid-area: stage; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .play-info { grid-area: info; display: grid; gap: 28px; align-content: start; }
  .play-intro { max-width: 60ch; font-size: 15px; line-height: 1.8; color: var(--text-body); }

  .play-frame { position: relative; width: 100%; height: calc(100svh - 150px); min-height: 480px; max-height: 820px; display: flex; flex-direction: column; border: 1px solid var(--line-solid); border-radius: 18px; overflow: hidden; background: var(--bg); box-shadow: 0 30px 70px var(--shadow); }
  .play-frame iframe { display: block; flex: 1; width: 100%; min-height: 0; border: 0; }
  .play-bar { display: none; height: 48px; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 12px; padding: 0 8px 0 16px; border-bottom: 1px solid var(--line); font: 700 15px var(--font-display); }
  .play-bar button { padding: 10px 12px; border-radius: 10px; font: 600 13px var(--font-sans); color: var(--text-soft); }
  .play-bar button:hover { background: var(--surface-hover); color: var(--accent-text); }
  .play-frame.is-immersive { position: fixed; inset: 0; z-index: 100; width: 100vw; height: 100dvh; max-height: none; min-height: 0; border: 0; border-radius: 0; }
  .play-frame.is-immersive .play-bar { display: flex; }
  :global(html.play-locked) { overflow: hidden; }
  .rotate-hint { display: none; }
  /* Phones held sideways: portrait-only games hide (which also stops their animation loop) behind a rotate prompt. */
  @media (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
    .play-frame[data-portrait] iframe { display: none; }
    .play-frame[data-portrait] .rotate-hint { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 24px; text-align: center; font: 600 16px/1.5 var(--font-sans); color: var(--text-soft); }
    .play-frame[data-portrait] .rotate-hint svg { color: var(--accent-text); animation: rotate-nudge 2.4s ease-in-out infinite; }
    .play-frame[data-portrait]:not(.is-immersive) { height: min(260px, calc(100svh - 24px)); min-height: 0; }
  }
  @keyframes rotate-nudge { 0%, 30% { transform: rotate(90deg); } 60%, 100% { transform: rotate(0deg); } }
  @media (prefers-reduced-motion: reduce) { .rotate-hint svg { animation: none !important; } }
  .play-tool { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border: 1px solid var(--line-strong); border-radius: 10px; font-size: 13px; color: var(--text-soft); }
  .play-tool:hover { border-color: var(--accent-text); color: var(--accent-text); }

  .play-subtitle { font: 700 20px var(--font-display); letter-spacing: -.02em; }
  .play-steps { margin-top: 12px; display: grid; gap: 10px; counter-reset: step; }
  .play-steps li { position: relative; padding-left: 40px; font-size: 14px; line-height: 1.7; color: var(--text-body); counter-increment: step; }
  .play-steps li::before { content: counter(step); position: absolute; left: 0; top: 0; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 8px; background: var(--accent-soft); color: var(--accent-text); font-weight: 700; font-size: 13px; }
  .play-features { margin-top: 12px; display: grid; gap: 8px; padding-left: 20px; list-style: disc; font-size: 14px; line-height: 1.7; color: var(--text-body); }
  .play-features li::marker { color: var(--accent-text); }
  .play-store { display: grid; gap: 16px; padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }


  .more-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }

  /* Phones and small tablets held sideways: let the game fill the screen height instead of a fixed 480px minimum. */
  @media (orientation: landscape) and (max-height: 600px) {
    .play-frame { height: calc(100svh - 24px); min-height: 0; max-height: none; }
    .play-stage { scroll-margin-top: 12px; }
  }

  @media (min-width: 900px) {
    .play-layout { grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto 1fr; grid-template-areas: "stage head" "stage info"; column-gap: 48px; row-gap: 28px; }
    .play-frame { width: calc(min(82vh, 800px) * 9 / 16); height: min(82vh, 800px); min-height: 0; }
    /* Games that lay out for landscape get a wide 16:9 stage that fits under the title on desktop; the guide moves below it in two columns. */
    .play-layout.is-wide { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: "head" "stage" "info"; row-gap: 24px; }
    .is-wide .play-frame { width: 100%; height: auto; aspect-ratio: 16 / 9; max-height: max(520px, calc(100svh - 290px)); min-height: 0; }
    .is-wide .play-info { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 48px; }
    .is-wide .play-info > * { grid-column: 1 / -1; }
    .is-wide .play-info > section:not(.play-store) { grid-column: auto; }
  }
  /* Big screens: the wide stage breaks out of the 72rem text column. */
  @media (min-width: 1200px) {
    .is-wide .play-stage { --stage: min(1320px, 100vw - 96px); width: var(--stage); margin-inline: calc((100% - var(--stage)) / 2); }
  }
</style>
